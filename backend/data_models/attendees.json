            "description": "User ID from auth system"
        },
        "identification": {
            "type": "string",
            "description": "National ID or passport number"
        },
        "full_name": {
            "type": "string",
            "description": "Full name"
        },
        "email": {
            "type": "string",
            "description": "Email address"
        },
        "phone": {
